# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Model to use (default for anthropic: claude-sonnet-5-5)
SEMANTIC_DIFF_MODEL=claude-sonnet-5-5

# Optional: OpenAI-compatible gateway instead of Anthropic
# (pip install 'semantic-diff[openai]'; model is then required)
# SEMANTIC_DIFF_PROVIDER=openai
# SEMANTIC_DIFF_BASE_URL=https://your-gateway.example/v1
# SEMANTIC_DIFF_API_KEY=...

# Optional: Max attempts per API call (default: 3)
SEMANTIC_DIFF_MAX_RETRIES=3

# Optional: Max total wait time for retries in seconds (default: 30.0)
SEMANTIC_DIFF_MAX_WAIT=30.0
